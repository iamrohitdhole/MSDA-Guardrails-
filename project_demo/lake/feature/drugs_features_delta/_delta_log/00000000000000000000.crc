.snappy.parquet","partitionValues":{},"size":1279666,"modificationTime":1762391592341,"dataChange":false,"stats":"{\"numRecords\":1642,\"minValues\":{\"drug_id\":\"DB00114\",\"drug_name\":\"(+)-2-(4-biphenyl)propionic acid\",\"avg_mass\":4.0026,\"description\":\"1-octacosanol is a straight-chai\",\"indication\":\"\\r\\nMorniflumate is indicated for \",\"mechanism\":\"\\r\\nThe commonly accepted choliner\",\"toxicity\":\"\\r\\n\\r\\n**Acute Exposure**\\r\\n\\r\\nNausea\",\"ingest_dt\":\"2025-11-04\",\"name_length\":3,\"desc_length\":3,\"has_toxicity_info\":0,\"mech_agonist\":0,\"mech_inhibitor\":0,\"mech_antagonist\":0,\"indication_index\":0.0},\"maxValues\":{\"drug_id\":\"DB19455\",\"drug_name\":\"{3-[(5-CHLORO-1,3-BENZOTHIAZOL-2\",\"avg_mass\":739.607,\"description\":\"norUrsodeoxycholic acid is under\",\"indication\":\"_In addition to any following in\",\"mechanism\":\"_In addition to any following in\",\"toxicity\":\"_In addition to any following in\",\"ingest_dt\":\"2025-11-04\",\"name_length\":187,\"desc_length\":511,\"has_toxicity_info\":1,\"mech_agonist\":1,\"mech_inhibitor\":1,\"mech_antagonist\":1,\"indication_index\":2605.0},\"nullCount\":{\"drug_id\":0,\"drug_name\":0,\"avg_mass\":0,\"description\":848,\"indication\":1233,\"mechanism\":1261,\"toxicity\":1375,\"ingest_dt\":0,\"name_length\":0,\"desc_length\":848,\"has_toxicity_info\":0,\"mech_agonist\":0,\"mech_inhibitor\":0,\"mech_antagonist\":0,\"indication_index\":0}}"},{"path":"part-00003-a01a0458-6e2e-4e48-93a0-3e40b8aa2d05-c000.snappy.parquet","partitionValues":{},"size":1271244,"modificationTime":1762391592335,"dataChange":false,"stats":"{\"numRecords\":1637,\"minValues\":{\"drug_id\":\"DB00119\",\"drug_name\":\"(+)-Rutamarin alcohol\",\"avg_mass\":10.81,\"description\":\"(1S,2R,3S,4R,5R)-2,3,4-trihydrox\",\"indication\":\"\\r\\nSelenium injection is indicate\",\"mechanism\":\"\\r\\n\\r\\nSodium selenite likely has t\",\"toxicity\":\"\\r\\n\",\"ingest_dt\":\"2025-11-04\",\"name_length\":4,\"des